# 服务监听
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库
DATABASE_URL=sqlite:///./data/app.db

# 登录（留空或 USE_AUTH=false 可关闭登录）
USE_AUTH=true
APP_USERNAME=admin
APP_PASSWORD=admin123

# OCR 引擎：rapidocr / paddleocr / baidu / none
OCR_ENGINE=rapidocr
OCR_LANG=ch

# 百度云 OCR（OCR_ENGINE=baidu 时必填，在百度智能云控制台获取）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# OCR 置信度阈值（低于该值字段标记"待人工确认"）
OCR_CONFIDENCE_THRESHOLD=0.6

# 单文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=50

# JPG 质量
JPG_QUALITY=92
